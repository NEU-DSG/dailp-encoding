{%- import "mets_macros.tera.xml" as mets -%}
<?xml version="1.0" encoding="UTF-8"?>
{{ mets::mets_open(objid=document_slug, label=document_title) }}
<!-- HEADER-->
{{ mets::mets_hdr(now=now) }}
<mets:mdSec>
  <!-- DUBLIN CORE/DESCRIPTIVE -->
  <mets:mdGrp USE="DESCRIPTIVE">
    <!-- GOING IN THE TEI FILE-->
  </mets:mdGrp>
  <!-- TECHNICAL-->
  <mets:mdGrp USE="TECHNICAL">
    <mets:md ID="{{ collection_slug ~ '_' ~ document_slug ~ '_' ~ image_oid ~ '_a_tmd' }}"><!-- EXAMPLE IF WE WANT IT, COULD USE PREMIS INSTEAD, COULD REMOVE AND JUST KEEP CHECKSUM WITH THE FILES-->
      <mets:mdWrap MIMETYPE="text/xml" MDTYPE="NISOIMG">

      </mets:mdWrap>
    </mets:md>
  </mets:mdGrp>
  <!--RIGHTS-->
  <mets:mdGrp USE="RIGHTS">
    {{ mets::rights_md() }}
  </mets:mdGrp>
</mets:mdSec>
<!-- File Section--><!-- You can add checksums as an atrribute to each file -->
<mets:fileSec>
  <mets:fileGrp USE="original">
    <!-- Overall audio -->
    {{ mets::file_entry(id=document_slug ~ "_m" ~ ext, loctype="URL", locref=audio_url) }}
    <!-- Manuscript image-->
    {{ mets::file_entry(id=collection_slug ~ "_" ~ document_slug ~ "_" ~ image_oid ~ "_m", loctype="URL", locref="https://collections.library.yale.edu/iiif/2/" ~ image_oid ~ "/full/max/0/default.jpg") }}
    <!-- TEI File -->
    <!-- LOCREF is a placeholder pattern; update once the TEI-hosting URL scheme is finalized -->
    {{ mets::file_entry(id=document_slug ~ "_tei_m", loctype="URL", locref="https://uat.dailp.northeastern.edu/documents/" ~ document_slug) }}
  </mets:fileGrp>
  <mets:fileGrp USE="cloud backup">
    <!-- Overall audio -->
    {{ mets::file_entry(id=document_slug ~ "_b" ~ ext, loctype="URL", locref="S3") }}
    <!-- Manuscript image-->
    {{ mets::file_entry(id=collection_slug ~ "_" ~ document_slug ~ "_" ~ image_oid ~ "_b", loctype="URL", locref="S3") }}
    <!-- TEI File -->
    {{ mets::file_entry(id=document_slug ~ "_tei_b", loctype="URL", locref="S3") }}
  </mets:fileGrp>
  <mets:fileGrp USE="archival">
    <!-- Overall audio -->
    {{ mets::file_entry(id=document_slug ~ "_a" ~ ext, loctype="SYSTEM", locref="FILE NAME.FORMAT EXTENSION") }}
    <!-- Manuscript image-->
    {{ mets::file_entry(id=collection_slug ~ "_" ~ document_slug ~ "_" ~ image_oid ~ "_a", loctype="SYSTEM", locref="FILE NAME.FORMAT EXTENSION", mdid=collection_slug ~ "_" ~ document_slug ~ "_" ~ image_oid ~ "_a_tmd") }}
    <!-- TEI File -->
    {{ mets::file_entry(id=document_slug ~ "_tei_a", loctype="SYSTEM", locref="FILE NAME.FORMAT EXTENSION") }}
  </mets:fileGrp>
</mets:fileSec>
<mets:structSec>
  <mets:structMap TYPE="logical">
      <mets:div TYPE="document" LABEL="{{ document_title }}">
        <mets:div TYPE="paired content" LABEL="{{ document_title ~ ' Overall Content' }}">
            <mets:fptr>
              <!-- If we want to directly link to lines in the TEI for each word, we should be able to. You would have to add a location for the lines in the TEI files under each word, then do a div with a <par> (for parallel) to
                collocate redundant copies in this structural map-->
              <mets:par>
                <mets:area FILEID="{{ collection_slug ~ '_' ~ document_slug ~ '_' ~ image_oid ~ '_m' }}"/>
                <mets:area FILEID="{{ document_slug ~ '_tei_m' }}"/>
                <mets:area FILEID="{{ document_slug ~ '_m' ~ ext }}"/>
              </mets:par>
            </mets:fptr>
        </mets:div>
        <!-- Word-by-word content (audio/TEI segments per word) is generated by the
             separate TEI pipeline and intentionally omitted here. -->
      </mets:div>
  </mets:structMap>
</mets:structSec>
</mets:mets>
