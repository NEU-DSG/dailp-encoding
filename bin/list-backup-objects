#!/usr/bin/env bash

set -ex

backup_bucket=$(jq -r '.resource.aws_s3_bucket.media_storage.bucket' < config.tf.json)

# Check who we are calling the APIs as
aws sts get-caller-identity

aws s3api list-objects --bucket "$backup_bucket" --prefix "db-backups"
aws s3api list-object-versions --bucket "$backup_bucket" --prefix "db-backups"

echo "Retrieving cloudfront distribution metadata..."
nix run --impure .#tf-cloudfront-dist
echo "done"

# Dry run of delete. Lists the objects and versions that we'd delete,
# followed by the command that would delete it if we were doing this
# for real.
versions_json="$(aws s3api list-object-versions --bucket "$backup_bucket" --prefix "db-backups")"
echo "$versions_json" | jq -r '.Versions.[] | .VersionId + "\t" + .Key' | while read version_id key ; do
	echo "Dry run: would remove key ${key} at version ${version_id}"
	echo aws s3api delete-object --bucket "${backup_bucket}" --key "${key}" --version-id "${version_id}"
done
