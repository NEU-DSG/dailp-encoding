#!/usr/bin/env bash

set -e

backup_bucket=$(jq -r '.resource.aws_s3_bucket.media_storage.bucket' < config.tf.json)

# Check who we are calling the APIs as
echo "AWS caller identity:"
aws sts get-caller-identity

# aws s3api list-objects --bucket "$backup_bucket" --prefix "db-backups"
# aws s3api list-object-versions --bucket "$backup_bucket" --prefix "db-backups"
# echo "Retrieving cloudfront distribution metadata..."
# nix run --impure .#tf-cloudfront-dist
# echo "done"

echo "Getting list of backup objects to delete"
aws s3api list-object-versions --bucket "$backup_bucket" --prefix "db-backups" |
jq -r '.Versions[] | .VersionId + "\t" + .Key' | while read version_id key ; do
	echo "Deleting backup object ${key} version ${version_id}"
	aws s3api delete-object --bucket "${backup_bucket}" --key "${key}" --version-id "${version_id}"
	echo "done"
done
echo "Done deleting backup objects"

echo "Retrieving metadata on cloudfront distribution..."
nix run --impure .#tf-cloudfront-dist

echo "Creating Cloudfront invalidation"
aws cloudfront create-invalidation --distribution-id E3BURE3XRHNGBC --paths "/db-backups/*"
echo "done"
